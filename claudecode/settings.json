{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(tree *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(go mod tidy)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make help)",
      "Bash(gh pr list)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr merge *)",
      "WebFetch",
      "Read",
      "Search"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false
  },
  "skillOverrides": {
    "use-railway": "off",
    "framer-motion-animator": "off",
    "opencode-review": "off",
    "linear": "off",
    "handoff": "off"
  },
  "effortLevel": "high",
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
