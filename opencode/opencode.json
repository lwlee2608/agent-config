{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.ssh/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask",
      "~/.kube/*": "ask",
      "~/.docker/*": "ask",
      "~/.config/gh/*": "ask",
      "~/.local/share/opencode/auth*": "ask"
    },
    "read": {
      "*": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*id_rsa*": "ask",
      "*id_ed25519*": "ask",
      "*credentials*": "ask",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "../*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "*id_rsa*": "ask",
      "*credentials*": "ask",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "provider": { "sort": "latency" }
      }
    }
  }
}
