{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "provider": { "sort": "latency" }
      },
      "models": {
        "moonshotai/kimi-k2.5": {
          "options": {
            "provider": {
              "order": ["moonshotai"],
              "allow_fallbacks": false
            }
          }
        },
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "order": ["minimax/highspeed"],
              "allow_fallbacks": false,
              "sort": "latency"
            }
          }
        },
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "sort": "latency"
            }
          }
        },
        "z-ai/glm-5.1": {
          "options": {
            "provider": {
              "sort": "latency"
            }
          }
        },
        "z-ai/glm-5": {
          "options": {
            "provider": {
              "sort": "latency"
            }
          }
        }
      }
    },
    "velocirouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VelociRouter",
      "options": {
        "baseURL": "https://api.velocirouter.site/v1",
        "headers": {
          "HTTP-Referer": "https://opencode.ai",
          "X-Title": "opencode"
        }
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "variants": { "none": {}, "low": {}, "medium": {}, "high": {}, "xhigh": {} },
          "attachment": true,
          "tool_call": true,
          "temperature": false,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
